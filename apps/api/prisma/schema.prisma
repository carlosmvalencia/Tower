generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth y usuarios
// ============================================================

enum UserRole {
  ADMIN
  SUPERVISOR
  OPERARIO
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(OPERARIO)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Maestros: clientes del 3PL y sus productos
// ============================================================

// Ambiente de almacenamiento. Mismo concepto que CONG/REF/SECO del rutero de Sandor.
enum Environment {
  FROZEN
  REFRIGERATED
  DRY
}

// Modelo de servicio que All-logistics le presta al cliente:
// INVENTORY = le llevamos el inventario completo; CROSS_DOCK = solo control
// estricto de cajas que entran/salen; BOTH = ambos.
enum CustomerServiceType {
  INVENTORY
  CROSS_DOCK
  BOTH
}

model Customer {
  id          String              @id @default(cuid())
  code        String              @unique // CL-0001
  name        String // razón social
  taxId       String? // NIT
  addressLine String?
  contactName String?
  phone       String?
  email       String?
  serviceType CustomerServiceType @default(INVENTORY)
  notes       String?
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  receipts          Receipt[]
  crossDockReceipts CrossDockReceipt[]
  sites             CustomerSite[]
  dispatches        Dispatch[]
  storageRates      StorageRate[]
  storageExtraRates StorageExtraRate[]
  storageDays       StorageDay[]
}

// Sede del cliente: destino de las salidas de mercancía.
// Ej: Gran Colombia tiene 12 sedes.
model CustomerSite {
  id          String  @id @default(cuid())
  customerId  String
  name        String
  addressLine String?
  city        String?
  contactName String?
  phone       String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id])
  dispatches Dispatch[]

  @@index([customerId])
}

// Cómo se maneja el producto: por peso (kg, cantidades decimales)
// o por unidades (enteros).
enum MeasureType {
  KG
  UND
}

// Producto DE UN CLIENTE: en un 3PL el mismo "pollo congelado" de dos
// clientes son dos productos distintos (dueños distintos del inventario).
model Product {
  id            String      @id @default(cuid())
  customerId    String
  code          String // código del cliente o interno; único por cliente
  name          String
  barcode       String? // EAN/UPC para escaneo con cámara
  measure       MeasureType @default(UND) // KG = por peso, UND = por unidades
  unit          String      @default("UND") // etiqueta visible: UND, CAJA, KG, ...
  environment   Environment
  shelfLifeDays Int? // vida útil típica, para validar vencimientos al recibir
  notes         String?
  isActive      Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      Customer        @relation(fields: [customerId], references: [id])
  lots          Lot[]
  lines         ReceiptLine[]
  moves         StockMovement[]
  dispatchLines DispatchLine[]
  adjustments   Adjustment[]

  @@unique([customerId, code])
  @@index([customerId])
  @@index([barcode])
  @@index([environment])
}

// ============================================================
// Configuración operativa (taras estándar, etc.)
// ============================================================

model Setting {
  key       String   @id // ej. tare.canastillaKg, tare.estibaKg
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// Recepción de inventario (clientes INVENTORY)
// ============================================================

enum ReceiptStatus {
  DRAFT // en registro — aún editable
  CONFIRMED // genera stock y cédulas definitivas
  CANCELLED
}

enum PalletStatus {
  IN_STORAGE
  DISPATCHED
}

// Lote: nace al confirmar una recepción. Base del FEFO.
model Lot {
  id         String    @id @default(cuid())
  productId  String
  code       String
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  product       Product         @relation(fields: [productId], references: [id])
  lines         ReceiptLine[]
  moves         StockMovement[]
  dispatchLines DispatchLine[]
  adjustments   Adjustment[]

  @@unique([productId, code])
  @@index([expiryDate])
}

model Receipt {
  id          String        @id @default(cuid())
  code        String        @unique // RB-0001
  customerId  String
  status      ReceiptStatus @default(DRAFT)
  receivedAt  DateTime      @default(now())
  notes       String?
  confirmedAt DateTime?
  createdById String?

  customer Customer      @relation(fields: [customerId], references: [id])
  pallets  Pallet[]
  lines    ReceiptLine[]
  photos   Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([receivedAt])
}

// Estiba cedulizada: el rótulo físico que entra al cuarto.
// Agrupa las pesadas (líneas) que van sobre esa estiba.
model Pallet {
  id          String       @id @default(cuid())
  code        String       @unique // TW-000001 — la "cédula"
  receiptId   String
  environment Environment // a qué cuarto/bodega entra
  status      PalletStatus @default(IN_STORAGE)
  createdAt   DateTime     @default(now())

  receipt Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lines   ReceiptLine[]

  @@index([receiptId])
}

// Una pesada: referencia + lote + pesos (o unidades).
model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  palletId  String?
  productId String
  lotCode   String
  expiryDate DateTime?
  lotId     String? // se fija al confirmar la recepción

  // Productos por KG:
  grossKg     Decimal? @db.Decimal(10, 2) // bruto (con canastillas y estiba)
  canastillas Int      @default(0)
  estibas     Int      @default(0)
  tareKg      Decimal? @db.Decimal(10, 2) // propuesta automática, editable
  netKg       Decimal? @db.Decimal(10, 2)

  // Productos por UND:
  units Int?

  notes     String?
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  pallet  Pallet? @relation(fields: [palletId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  lot     Lot?    @relation(fields: [lotId], references: [id])

  movement StockMovement?

  @@index([receiptId])
  @@index([palletId])
}

// ============================================================
// Kardex: libro mayor de movimientos. El stock SIEMPRE se
// calcula de aquí — nunca se edita a mano.
// ============================================================

enum StockMovementType {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
}

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  productId String
  lotId     String?
  // kg (decimal) para productos por peso; unidades para los demás
  qty       Decimal           @db.Decimal(12, 2)
  reference String? // documento origen legible, ej. "Entrada EM-0001"

  receiptLineId  String? @unique
  dispatchLineId String? @unique
  adjustmentId   String? @unique
  createdById    String?
  createdAt      DateTime @default(now())

  product      Product       @relation(fields: [productId], references: [id])
  lot          Lot?          @relation(fields: [lotId], references: [id])
  line         ReceiptLine?  @relation(fields: [receiptLineId], references: [id])
  dispatchLine DispatchLine? @relation(fields: [dispatchLineId], references: [id])
  adjustment   Adjustment?   @relation(fields: [adjustmentId], references: [id])

  @@index([productId])
  @@index([lotId])
  @@index([createdAt])
}

// ============================================================
// Salidas de mercancía (SM): descuentan inventario hacia una
// sede del cliente. Las líneas eligen lote (FEFO sugerido).
// ============================================================

enum DispatchStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Dispatch {
  id          String         @id @default(cuid())
  code        String         @unique // SM-0001
  customerId  String
  siteId      String?
  status      DispatchStatus @default(DRAFT)
  dispatchedAt DateTime      @default(now())
  notes       String?
  confirmedAt DateTime?
  createdById String?

  customer Customer       @relation(fields: [customerId], references: [id])
  site     CustomerSite?  @relation(fields: [siteId], references: [id])
  lines    DispatchLine[]
  photos   Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([dispatchedAt])
}

model DispatchLine {
  id         String  @id @default(cuid())
  dispatchId String
  productId  String
  lotId      String
  qty        Decimal @db.Decimal(12, 2) // kg o unidades según el producto
  notes      String?
  createdAt  DateTime @default(now())

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  lot      Lot      @relation(fields: [lotId], references: [id])

  movement StockMovement?

  @@index([dispatchId])
}

// ============================================================
// Ajustes de inventario (AJ): correcciones +/- con motivo,
// solo Supervisor/Admin. Un ajuste = un movimiento.
// ============================================================

enum AdjustmentDirection {
  IN
  OUT
}

model Adjustment {
  id          String              @id @default(cuid())
  code        String              @unique // AJ-0001
  productId   String
  lotId       String
  direction   AdjustmentDirection
  qty         Decimal             @db.Decimal(12, 2)
  reason      String // motivo obligatorio
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())

  product Product @relation(fields: [productId], references: [id])
  lot     Lot     @relation(fields: [lotId], references: [id])

  movement StockMovement?

  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// Almacenaje: control diario de posiciones y kg por cliente,
// con tarifario por contrato. Reemplaza las planillas de
// "Control Almacenaje" / "Movimiento Global".
// ============================================================

// Unidad de cobro del almacenaje de un cliente en un ambiente.
enum StorageChargeUnit {
  POSITION_DAY // $/posición/día (la mayoría de clientes)
  KG_DAY // $/kg/día (ej. Gran Colombia; Del Alba en refrigerado)
}

// Tarifa de almacenaje por cliente+ambiente, con vigencia (histórico de precios).
model StorageRate {
  id          String            @id @default(cuid())
  customerId  String
  environment Environment
  unit        StorageChargeUnit
  ratePerDay  Decimal           @db.Decimal(12, 2)
  validFrom   DateTime
  createdAt   DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, environment, validFrom])
}

// Conceptos adicionales: cargue/descargue, nivelación de temperatura, otros.
enum StorageExtraKind {
  CARGUE_DESCARGUE
  NIVELACION
  OTRO
}

model StorageExtraRate {
  id         String           @id @default(cuid())
  customerId String
  kind       StorageExtraKind
  name       String? // para OTRO
  ratePerKg  Decimal          @db.Decimal(12, 2)
  validFrom  DateTime
  createdAt  DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, kind, validFrom])
}

// Registro diario MANUAL por cliente+ambiente. Los saldos (posiciones y kg)
// se calculan acumulando estos registros — nunca se digitan.
model StorageDay {
  id          String      @id @default(cuid())
  date        DateTime // día (00:00 UTC)
  customerId  String
  environment Environment

  posIn  Int @default(0)
  posOut Int @default(0)

  kgIn  Decimal @default(0) @db.Decimal(12, 2)
  kgOut Decimal @default(0) @db.Decimal(12, 2)

  // Cargue/descargue: por defecto kgIn+kgOut; este campo lo sobreescribe.
  kgHandledOverride Decimal? @db.Decimal(12, 2)
  // Nivelación de temperatura (solo congelado, cuando llega fuera de rango).
  kgLeveled Decimal @default(0) @db.Decimal(12, 2)

  note       String?
  invoiceRef String? // No. de factura cuando el día ya se facturó

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([date, customerId, environment])
  @@index([customerId, date])
  @@index([date])
}

// ============================================================
// Cross-dock: descargues (entradas de cajas) y salidas parciales
// ============================================================

enum CrossDockStatus {
  OPEN // con cajas pendientes por salir
  CLOSED // saldo en cero
  CANCELLED
}

model CrossDockReceipt {
  id         String          @id @default(cuid())
  code       String          @unique // CD-0001
  customerId String
  status     CrossDockStatus @default(OPEN)
  arrivedAt  DateTime        @default(now())
  boxesIn    Int
  grossKg    Decimal?        @db.Decimal(10, 2)
  notes      String?
  createdById String?

  customer   Customer            @relation(fields: [customerId], references: [id])
  dispatches CrossDockDispatch[]
  photos     Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model CrossDockDispatch {
  id                 String   @id @default(cuid())
  crossDockReceiptId String
  dispatchedAt       DateTime @default(now())
  boxesOut           Int
  destination        String? // vehículo/destino, texto libre
  notes              String?
  createdById        String?
  createdAt          DateTime @default(now())

  crossDockReceipt CrossDockReceipt @relation(fields: [crossDockReceiptId], references: [id], onDelete: Cascade)
  photos           Photo[]

  @@index([crossDockReceiptId])
}

// ============================================================
// Fotos (soportes): key del StorageService (local/GCS)
// ============================================================

model Photo {
  id                  String   @id @default(cuid())
  key                 String // folder/uuid.ext en el storage
  receiptId           String?
  dispatchId          String?
  crossDockReceiptId  String?
  crossDockDispatchId String?
  createdById         String?
  createdAt           DateTime @default(now())

  receipt           Receipt?           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  dispatch          Dispatch?          @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  crossDockReceipt  CrossDockReceipt?  @relation(fields: [crossDockReceiptId], references: [id], onDelete: Cascade)
  crossDockDispatch CrossDockDispatch? @relation(fields: [crossDockDispatchId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([dispatchId])
  @@index([crossDockReceiptId])
  @@index([crossDockDispatchId])
}
