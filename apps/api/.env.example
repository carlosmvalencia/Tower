# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5174

# Database (Postgres local de Tower — puerto 5433 para no chocar con Sandor)
DATABASE_URL="postgresql://tower:tower_dev@localhost:5433/tower?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Storage de archivos (fotos de soporte de recepción, etc.)
# local (dev): guarda en disco UPLOADS_DIR, servido por /uploads
# gcs (prod): Cloud Storage con signed URLs
STORAGE_BACKEND=local
UPLOADS_DIR=./uploads
PUBLIC_API_URL=http://localhost:3001
# Solo para gcs:
# GCS_BUCKET=tower-uploads-sandor-prod
