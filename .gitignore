# Dependencias
node_modules/

# Builds
dist/
build/
out/

# Entornos (nunca subir claves al repo)
.env
.env.local
.env.*.local
.env.production
!.env.example
# Excepción: el .env.production del web solo contiene la URL pública de la
# API (ningún secreto) y el CI lo necesita para construir el bundle.
!apps/web/.env.production

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Coverage / build info
coverage/
*.tsbuildinfo

# Docker volumes
infra/data/

# Uploads locales (fotos de soporte en dev)
apps/api/uploads/

# Firebase
.firebase/
firebase-debug.log

# Archivos operativos con datos reales (NO publicar)
docs/*.xlsx
docs/*.csv
